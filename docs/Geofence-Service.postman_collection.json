  {
    "info": {
      "name": "Geofence Service",
      "description": "CRUD and spatial lookup APIs for agency/client geofences. Geofences are stored server-side as Oracle Spatial MDSYS.SDO_GEOMETRY and scoped by agency (mandatory) and client (optional). Generated from internal/swagger/geofence-openapi.yaml.",
      "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
      { "key": "baseUrl", "value": "http://localhost:7006/api/v1", "type": "string" },
      { "key": "agency_id", "value": "11111111-1111-1111-1111-111111111111", "type": "string" },
      { "key": "client_id", "value": "22222222-2222-2222-2222-222222222222", "type": "string" },
      { "key": "user_id", "value": "33333333-3333-3333-3333-333333333333", "type": "string" },
      { "key": "geofence_id", "value": "", "type": "string" },
      { "key": "correlation_id", "value": "{{$guid}}", "type": "string" }
    ],
    "item": [
      {
        "name": "Health",
        "item": [
          {
            "name": "Health Check",
            "request": {
              "method": "GET",
              "header": [],
              "url": {
                "raw": "{{baseUrl}}/health",
                "host": ["{{baseUrl}}"],
                "path": ["health"]
              }
            },
            "response": []
          }
        ]
      },
      {
        "name": "Geofences",
        "item": [
          {
            "name": "Create Geofence (Circle)",
            "event": [
              {
                "listen": "test",
                "script": {
                  "type": "text/javascript",
                  "exec": [
                    "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                    "if (pm.response.code === 201) {",
                    "    const body = pm.response.json();",
                    "    if (body && body.data && body.data.id) {",
                    "        pm.collectionVariables.set('geofence_id', body.data.id);",
                    "    }",
                    "}"
                  ]
                }
              }
            ],
            "request": {
              "method": "POST",
              "header": [
                { "key": "Content-Type", "value": "application/json" },
                { "key": "x-correlation-id", "value": "{{correlation_id}}" }
              ],
              "body": {
                "mode": "raw",
                "raw": "{\n  \"name\": \"Downtown Parole Office\",\n  \"geo_json\": {\n    \"type\": \"Circle\",\n    \"coordinates\": [-122.4194, 37.7749],\n    \"radius\": 150,\n    \"address\": {\n      \"name\": \"Downtown Parole Office\",\n      \"street1\": \"123 Main St\",\n      \"street2\": \"\",\n      \"city\": \"San Francisco\",\n      \"state_province_id\": 6,\n      \"state_province\": \"CA\",\n      \"state_province_name\": \"California\",\n      \"postal_code\": \"94103\",\n      \"country\": \"US\"\n    }\n  },\n  \"status\": \"active\",\n  \"user_id\": \"{{user_id}}\",\n  \"client_id\": \"{{client_id}}\",\n  \"exclude_from_colocation\": false,\n  \"notes\": \"Visiting hours 9am-5pm\"\n}"
              },
              "url": {
                "raw": "{{baseUrl}}/agencies/{{agency_id}}/geofences",
                "host": ["{{baseUrl}}"],
                "path": ["agencies", "{{agency_id}}", "geofences"]
              }
            },
            "response": []
          },
          {
            "name": "Create Geofence (Polygon)",
            "request": {
              "method": "POST",
              "header": [
                { "key": "Content-Type", "value": "application/json" },
                { "key": "x-correlation-id", "value": "{{correlation_id}}" }
              ],
              "body": {
                "mode": "raw",
                "raw": "{\n  \"name\": \"Riverside District\",\n  \"geo_json\": {\n    \"type\": \"Polygon\",\n    \"coordinates\": [\n      [\n        [-122.43, 37.77],\n        [-122.41, 37.77],\n        [-122.41, 37.79],\n        [-122.43, 37.79],\n        [-122.43, 37.77]\n      ]\n    ],\n    \"address\": {\n      \"name\": \"Riverside District\",\n      \"street1\": \"\",\n      \"street2\": \"\",\n      \"city\": \"San Francisco\",\n      \"state_province_id\": 6,\n      \"state_province\": \"CA\",\n      \"state_province_name\": \"California\",\n      \"postal_code\": \"94103\",\n      \"country\": \"US\"\n    }\n  },\n  \"status\": \"active\",\n  \"user_id\": \"{{user_id}}\",\n  \"client_id\": null,\n  \"exclude_from_colocation\": false,\n  \"notes\": null\n}"
              },
              "url": {
                "raw": "{{baseUrl}}/agencies/{{agency_id}}/geofences",
                "host": ["{{baseUrl}}"],
                "path": ["agencies", "{{agency_id}}", "geofences"]
              }
            },
            "response": []
          },
          {
            "name": "Create Geofence (Rectangle)",
            "request": {
              "method": "POST",
              "header": [
                { "key": "Content-Type", "value": "application/json" },
                { "key": "x-correlation-id", "value": "{{correlation_id}}" }
              ],
              "body": {
                "mode": "raw",
                "raw": "{\n  \"name\": \"Warehouse Perimeter\",\n  \"geo_json\": {\n    \"type\": \"Rectangle\",\n    \"coordinates\": [\n      [-122.42, 37.76],\n      [-122.40, 37.78]\n    ],\n    \"address\": {\n      \"name\": \"Warehouse District\",\n      \"street1\": \"\",\n      \"street2\": \"\",\n      \"city\": \"San Francisco\",\n      \"state_province_id\": 6,\n      \"state_province\": \"CA\",\n      \"state_province_name\": \"California\",\n      \"postal_code\": \"94124\",\n      \"country\": \"US\"\n    }\n  },\n  \"status\": \"active\",\n  \"user_id\": \"{{user_id}}\",\n  \"client_id\": \"{{client_id}}\",\n  \"exclude_from_colocation\": false,\n  \"notes\": null\n}"
              },
              "url": {
                "raw": "{{baseUrl}}/agencies/{{agency_id}}/geofences",
                "host": ["{{baseUrl}}"],
                "path": ["agencies", "{{agency_id}}", "geofences"]
              }
            },
            "response": []
          },
          {
            "name": "List Geofences",
            "request": {
              "method": "GET",
              "header": [

                { "key": "x-correlation-id", "value": "{{correlation_id}}" }
              ],
              "url": {
                "raw": "{{baseUrl}}/agencies/{{agency_id}}/geofences?client_id={{client_id}}&status=active&page=1&page_size=25",
                "host": ["{{baseUrl}}"],
                "path": ["agencies", "{{agency_id}}", "geofences"],
                "query": [
                  { "key": "client_id", "value": "{{client_id}}", "description": "Optional. Filter to a specific client." },
                  { "key": "status", "value": "active", "description": "Optional. active | inactive | archived | deleted" },
                  { "key": "page", "value": "1" },
                  { "key": "page_size", "value": "25" }
                ]
              }
            },
            "response": []
          },
          {
            "name": "Lookup Geofences by Point",
            "request": {
              "method": "GET",
              "header": [
                { "key": "x-correlation-id", "value": "{{correlation_id}}" }
              ],
              "url": {
                "raw": "{{baseUrl}}/agencies/{{agency_id}}/geofences/lookup?lon=-122.4194&lat=37.7749&client_id={{client_id}}",
                "host": ["{{baseUrl}}"],
                "path": ["agencies", "{{agency_id}}", "geofences", "lookup"],
                "query": [
                  { "key": "lon", "value": "-122.4194", "description": "Longitude in [-180, 180]." },
                  { "key": "lat", "value": "37.7749", "description": "Latitude in [-90, 90]." },
                  { "key": "client_id", "value": "{{client_id}}", "description": "Optional." }
                ]
              }
            },
            "response": []
          },
          {
            "name": "Get Geofence by Id",
            "request": {
              "method": "GET",
              "header": [
                { "key": "x-correlation-id", "value": "{{correlation_id}}" }
              ],
              "url": {
                "raw": "{{baseUrl}}/agencies/{{agency_id}}/geofences/{{geofence_id}}",
                "host": ["{{baseUrl}}"],
                "path": ["agencies", "{{agency_id}}", "geofences", "{{geofence_id}}"]
              }
            },
            "response": []
          },
          {
            "name": "Update Geofence (partial - notes only)",
            "request": {
              "method": "PATCH",
              "header": [
                { "key": "Content-Type", "value": "application/json" },
                { "key": "x-correlation-id", "value": "{{correlation_id}}" }
              ],
              "body": {
                "mode": "raw",
                "raw": "{\n  \"notes\": \"Radius widened per site review\",\n  \"user_id\": \"{{user_id}}\",\n  \"version\": 1\n}"
              },
              "url": {
                "raw": "{{baseUrl}}/agencies/{{agency_id}}/geofences/{{geofence_id}}",
                "host": ["{{baseUrl}}"],
                "path": ["agencies", "{{agency_id}}", "geofences", "{{geofence_id}}"]
              },
              "description": "PATCH only requires user_id and version; every other field is optional and, if omitted, keeps its current value. Fields shown below (client_id, notes) may be explicitly set to null to clear them."
            },
            "response": []
          },
          {
            "name": "Update Geofence (full replacement)",
            "request": {
              "method": "PATCH",
              "header": [
                { "key": "Content-Type", "value": "application/json" },
                { "key": "x-correlation-id", "value": "{{correlation_id}}" }
              ],
              "body": {
                "mode": "raw",
                "raw": "{\n  \"name\": \"Downtown Parole Office\",\n  \"geo_json\": {\n    \"type\": \"Circle\",\n    \"coordinates\": [-122.4194, 37.7749],\n    \"radius\": 200,\n    \"address\": {\n      \"name\": \"Downtown Parole Office\",\n      \"street1\": \"123 Main St\",\n      \"street2\": \"\",\n      \"city\": \"San Francisco\",\n      \"state_province_id\": 6,\n      \"state_province\": \"CA\",\n      \"state_province_name\": \"California\",\n      \"postal_code\": \"94103\",\n      \"country\": \"US\"\n    }\n  },\n  \"status\": \"active\",\n  \"user_id\": \"{{user_id}}\",\n  \"client_id\": \"{{client_id}}\",\n  \"exclude_from_colocation\": false,\n  \"notes\": \"Radius widened per site review\",\n  \"version\": 1\n}"
              },
              "url": {
                "raw": "{{baseUrl}}/agencies/{{agency_id}}/geofences/{{geofence_id}}",
                "host": ["{{baseUrl}}"],
                "path": ["agencies", "{{agency_id}}", "geofences", "{{geofence_id}}"]
              }
            },
            "response": []
          },
          {
            "name": "Delete Geofence",
            "request": {
              "method": "DELETE",
              "header": [
                { "key": "x-correlation-id", "value": "{{correlation_id}}" }
              ],
              "url": {
                "raw": "{{baseUrl}}/agencies/{{agency_id}}/geofences/{{geofence_id}}?user_id={{user_id}}",
                "host": ["{{baseUrl}}"],
                "path": ["agencies", "{{agency_id}}", "geofences", "{{geofence_id}}"],
                "query": [
                  { "key": "user_id", "value": "{{user_id}}", "description": "Identity of whoever is performing the delete." }
                ]
              }
            },
            "response": []
          }
        ]
      }
    ]
  }