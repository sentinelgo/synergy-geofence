# Merged on top of config.yaml.tmpl (second --config flag wins per key).
# secret_value pulls from Vault at {project}/{partition}/geofence/geofence
# (per project.yaml's secrets_engine.path_template) — ops must populate
# the "db_password" key there before this partition can deploy.
common:
  datastore:
    password: {{ secret_value "db_password" }}