# Image
REGISTRY=ocir.us-langley-1.oci.oraclegovcloud.com
NAMESPACE=focalpointcloud
FOLDER=synergy_application_services
IMAGE_NAME=geofence-service
IMAGE_TAG=1.0.0

# Runtime
# TARGET_HOST is shared across dev/qa/demo — PUBLISHED_PORT (the host-side
# port in docker-stack.yml's ${PUBLISHED_PORT}:${SERVER_PORT} mapping) is
# what keeps the three stacks from colliding on that one host.
TARGET_HOST=10.21.1.25
ACTIVE_ENVIRONMENT=demo
SERVER_PORT=7010
PUBLISHED_PORT=8182
REPLICA_NUMBER=1
CONFIG_SECRET=geofence_config_demo
LOG_LEVEL=debug

# Oracle datastore — matches config.yml common.datastore
ORACLE_HOST=172.31.232.97
ORACLE_PORT=1521
ORACLE_USER=GEOFENCE_USER_DEMO
ORACLE_PASSWORD={{ORACLE_PASSWORD}}
ORACLE_SERVICE_NAME=SYNQA.lswifppddb01.lswifppd.oraclevcn.com

# Pulsar — matches config.yml pulsar
PULSAR_URL=pulsar://10.20.4.28:6651
PULSAR_CONSUMER_TOPIC=persistent://synergy/demo.geofences/geofence_events


# Identity / JWT — matches config.yml common.jwt and common.signing.
# Keep normal JWT validation enabled; opaque portal tokens are validated by
# the public Hydra /userinfo endpoint before the JWT middleware runs.
JWT_VERIFICATION_DISABLED=false
IDENTITY_DOMAIN=demo.sentinelsyn.com
GEOFENCE_AUTH_ENABLED=true
GEOFENCE_AUTH_AUDIENCE=geofence.demo.sentinelsyn.com
HYDRA_USERINFO_URL=https://id.demo.sentinelsyn.com/userinfo
