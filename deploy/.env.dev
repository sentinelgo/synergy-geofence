# Image
REGISTRY=ocir.us-langley-1.oci.oraclegovcloud.com
NAMESPACE=focalpointcloud
FOLDER=synergy_application_services
IMAGE_NAME=geofence-service
IMAGE_TAG=1.0.0

# Runtime
TARGET_HOST=10.21.2.25
ACTIVE_ENVIRONMENT=dev
SERVER_PORT=7010
REPLICA_NUMBER=1
CONFIG_SECRET=geofence_config_dev
LOG_LEVEL=debug

# Oracle datastore — matches config.yml common.datastore
ORACLE_HOST=172.31.232.97
ORACLE_PORT=1521
ORACLE_USER=GEOFENCE_USER_DEV
ORACLE_PASSWORD={{ORACLE_PASSWORD}}
ORACLE_SERVICE_NAME=SYNQA.lswifppddb01.lswifppd.oraclevcn.com

# Pulsar — matches config.yml pulsar
PULSAR_URL=pulsar://10.20.4.28:6651
PULSAR_CONSUMER_TOPIC=persistent://synergy/dev.geofences/geofence_events

#sidecar
SIDECAR_URL=http://localhost:8090