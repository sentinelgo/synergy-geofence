# Image
REGISTRY=ocir.us-langley-1.oci.oraclegovcloud.com
NAMESPACE=focalpointcloud
FOLDER=synergy_application_services
IMAGE_NAME=geofence-service
IMAGE_TAG=1.0.0

# Runtime
# Dev is deployed on its dedicated host; PUBLISHED_PORT is the host-side port
# in docker-stack.dev.yml's ${PUBLISHED_PORT}:${SERVER_PORT} mapping.
TARGET_HOST=10.21.1.25
ACTIVE_ENVIRONMENT=dev
SERVER_PORT=7010
PUBLISHED_PORT=8180
REPLICA_NUMBER=1
CONFIG_SECRET=geofence_config_dev
AGENCY_CLIENT_SECRET_NAME=geofence_agency_client_secret_dev
LOG_LEVEL=debug

# Oracle datastore — matches config.yml common.datastore
ORACLE_HOST=172.31.232.97
ORACLE_PORT=1521
ORACLE_USER=GEOFENCE_USER_DEV
ORACLE_PASSWORD={{ORACLE_PASSWORD}}
ORACLE_SERVICE_NAME=SYNQA.lswifppddb01.lswifppd.oraclevcn.com

# Pulsar — matches config.yml pulsar
PULSAR_URL=pulsar://10.20.4.28:6651
PULSAR_CONSUMER_TOPIC=persistent://synergy/dev.geofences/geofence_events

# Activity-log (audit)
ACTIVITY_LOG_ADDRESS=10.21.1.40:50054


# Identity / JWT — matches config.yml common.jwt and common.signing.
# Keep normal JWT validation enabled; opaque portal tokens are validated by
# the public Hydra /userinfo endpoint before the JWT middleware runs.
JWT_VERIFICATION_DISABLED=false
IDENTITY_DOMAIN=dev.sentinelsyn.com
GEOFENCE_AUTH_ENABLED=true
GEOFENCE_AUTH_AUDIENCE=geofence.dev.sentinelsyn.com
HYDRA_USERINFO_URL=https://id.dev.sentinelsyn.com/userinfo

# Agency service m2m client — matches config.yml common.agency. A
# confidential Hydra client (client_credentials, client_secret_basic,
# agency.read scope only), one per environment. AGENCY_SERVICE_BASE_URL/
# HYDRA_TOKEN_URL follow this env's existing agency./id. host conventions;
# verify both before relying on this in a real deploy.
#
# GEOFENCE_AGENCY_CLIENT_SECRET_DEV is NOT baked into config.yml and NOT
# passed to the container as an environment variable — unlike every other
# value here, it's written into its own dedicated Docker secret (see
# AGENCY_CLIENT_SECRET_NAME above, deploy/docker-stack.dev.yml's
# geofence_agency_client_secret secret, and the Jenkinsfile's "Create Agency
# Client Secret" stage) and mounted as a file the app reads directly (see
# config.yml's client-secret: /run/secrets/geofence_agency_client_secret).
# The {{...}} placeholder below only exists so the Vault-fetch loop in
# Jenkins' "Load Dev Config" stage resolves the real secret from Vault via
# OCI_VAULT_SECRET_GEOFENCE_AGENCY_CLIENT_SECRET_DEV=<vault-ocid> in
# Dev.properties — it's never written to a running container's environment.
AGENCY_SERVICE_BASE_URL=https://agency.dev.sentinelsyn.com
GEOFENCE_AGENCY_CLIENT_ID=0df028d9-adf4-40d1-ab00-30b3a6a53c0e
GEOFENCE_AGENCY_CLIENT_SECRET_DEV={{GEOFENCE_AGENCY_CLIENT_SECRET_DEV}}
HYDRA_TOKEN_URL=https://id.dev.sentinelsyn.com/oauth2/token
