# Image
REGISTRY=ocir.us-langley-1.oci.oraclegovcloud.com
NAMESPACE=focalpointcloud
FOLDER=synergy_application_services
IMAGE_NAME=geofence-service
IMAGE_TAG=1.0.0

# Runtime
# Prod is a 3-node, manager-only Swarm cluster (see docker-stack.yml's
# node.role == manager placement constraint). TARGET_HOST is the manager
# `docker stack deploy` is run from; WORKER_HOSTS (consumed by
# Jenkinsfile.promote's `for host in $TARGET_HOST $WORKER_HOSTS` copy loop)
# should list the other two manager IPs, space- or comma-separated, in
# Prod.properties — REPLICA_NUMBER=3 gives one replica per manager for HA.
TARGET_HOST={{PROD_MANAGER_1_HOST}}
WORKER_HOSTS={{PROD_MANAGER_2_HOST}},{{PROD_MANAGER_3_HOST}}
ACTIVE_ENVIRONMENT=prod
SERVER_PORT=7010
PUBLISHED_PORT=8180
REPLICA_NUMBER=3
CONFIG_SECRET=geofence_config_prod
AGENCY_CLIENT_SECRET_NAME=geofence_agency_client_secret_prod
LOG_LEVEL=info

# Oracle datastore — matches config.yml common.datastore
ORACLE_HOST=172.31.232.55
ORACLE_PORT=1521
ORACLE_USER=GEOFENCE_USER
ORACLE_PASSWORD={{ORACLE_PASSWORD}}
ORACLE_SERVICE_NAME=SYNPROD.lswifppddb01.lswifppd.oraclevcn.com

# Pulsar — matches config.yml pulsar
PULSAR_URL=pulsar://10.20.5.28:6651
PULSAR_CONSUMER_TOPIC=persistent://synergy/prod.geofences/geofence_events

# Identity / JWT — matches config.yml common.jwt and common.signing.
# Keep normal JWT validation enabled; opaque portal tokens are validated by
# the public Hydra /userinfo endpoint before the JWT middleware runs.
JWT_VERIFICATION_DISABLED=false
IDENTITY_DOMAIN=sentinelsso.com
GEOFENCE_AUTH_ENABLED=true
GEOFENCE_AUTH_AUDIENCE=geofence.sentinelsso.com
HYDRA_USERINFO_URL=https://login.sentinelsyn.com/userinfo

# Agency service m2m client — matches config.yml common.agency. A
# confidential Hydra client (client_credentials, client_secret_basic,
# agency.read scope only), one per environment. AGENCY_SERVICE_BASE_URL
# follows the agency.${IDENTITY_DOMAIN} convention config.yml's jwt/signing
# issuers already use for prod; HYDRA_TOKEN_URL mirrors HYDRA_USERINFO_URL's
# actual host above (a different domain from IDENTITY_DOMAIN in prod).
# Verify both before relying on this in a real deploy.
#
# GEOFENCE_AGENCY_CLIENT_SECRET_PROD is NOT baked into config.yml and NOT
# passed to the container as an environment variable — unlike every other
# value here, it's written into its own dedicated Docker secret (see
# AGENCY_CLIENT_SECRET_NAME above, deploy/docker-stack.yml's
# geofence_agency_client_secret secret, and the Jenkinsfile's "Create Agency
# Client Secret" stage) and mounted as a file the app reads directly (see
# config.yml's client-secret: /run/secrets/geofence_agency_client_secret).
# The {{...}} placeholder below only exists so the Vault-fetch loop resolves
# the real secret from Vault via
# OCI_VAULT_SECRET_GEOFENCE_AGENCY_CLIENT_SECRET_PROD=<vault-ocid> in
# Prod.properties — it's never written to a running container's environment.
AGENCY_SERVICE_BASE_URL=https://agency.sentinelsso.com
GEOFENCE_AGENCY_CLIENT_ID=4d99f69c-e191-438a-b875-d39367f2ab14
GEOFENCE_AGENCY_CLIENT_SECRET_PROD={{GEOFENCE_AGENCY_CLIENT_SECRET_PROD}}
HYDRA_TOKEN_URL=https://login.sentinelsyn.com/oauth2/token
